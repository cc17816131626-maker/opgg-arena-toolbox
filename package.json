{
  "name": "opgg-arena-toolbox",
  "private": true,
  "version": "0.1.0",
  "description": "OP.GG 斗魂竞技场（Arena）离线桌面端工具箱 - 数据抓取流水线 + Tauri 客户端",
  "scripts": {
    "start": "node scripts/start.mjs",
    "scraper": "pnpm --filter scraper",
    "app": "pnpm --filter app",
    "dev:app": "pnpm --filter app dev",
    "build:app": "pnpm --filter app build",
    "configure:github": "node scripts/apply-github-config.mjs",
    "test": "pnpm --filter app test",
    "test:e2e": "pnpm --filter app test:e2e",
    "typecheck": "pnpm --filter app exec tsc --noEmit && pnpm --filter scraper typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3"
}
