{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arena Helper",
  "version": "0.1.0",
  "identifier": "com.opgg-toolbox.arena",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "斗魂竞技场助手",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/seed-data.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1Mzg2ODUwREU3OUQwNjYKUldSbTBIbmVVR2c0dFhPRm9SUnBLSklxSVZiQXNBOVhrYzBUN2hMeWtRbFJVWk5oMmlxTFJhRG0K",
      "endpoints": [
        "https://github.com/cc17816131626-maker/opgg-arena-toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}
